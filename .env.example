# Create a key in Google AI Studio using a Free Tier project without billing.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=

# Public Supabase configuration. Use a publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_SIGN_IN=false

# Vercel only. Require a signed-in adult using AI for professional learning in the U.S. or Canada.
HOSTED_GEMINI=false
